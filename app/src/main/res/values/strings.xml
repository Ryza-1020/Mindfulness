    <!-- Settings -->
    <string name="settings_title">הגדרות</string>
    <string name="settings_section_block">השתקת הסחות דעת</string>
    <string name="settings_block_notifications">השתקת התראות ושיחות בזמן עבודה</string>
    <string name="settings_block_notifications_desc">מפעיל מצב \"נא לא להפריע\" של Android. שיחות נכנסות עדיין מתקבלות – הן רק לא מצלצלות ויופיעו כשיחות שלא נענו.</string>
    <string name="settings_calls">שיחות שיעברו בכל זאת</string>
    <string name="calls_none">אף אחד</string>
    <string name="calls_starred">אנשי קשר מועדפים (כוכב)</string>
    <string name="calls_contacts">כל אנשי הקשר</string>
    <string name="settings_repeat_callers">לאפשר מתקשר חוזר (אותו מספר תוך 15 דקות)</string>
    <string name="settings_block_note">שעונים מעוררים ממשיכים לפעול. אפליקציות שהגדרת בהגדרות המכשיר כ\"מותר לעקוף את נא לא להפריע\" ימשיכו להתריע. שיחות חירום אינן נחסמות.</string>
    <string name="settings_section_lock">נעילת מסך</string>
    <string name="settings_pinning">הצמדת מסך בזמן עבודה</string>
    <string name="settings_pinning_desc">בתחילת כל סשן Android יבקש לאשר הצמדה. במצב מוצמד אי אפשר לעבור לאפליקציות אחרות או לפתוח התראות. היציאה מהצמדה אפשרית תמיד: בניווט במחוות – החלקה למעלה והחזקה; בניווט בכפתורים – לחיצה ארוכה על \"חזרה\" ו\"סקירה\" יחד.</string>
    <string name="settings_pinning_setup">אם ההצמדה לא מופעלת, יש להפעיל אותה בהגדרות המכשיר: אבטחה ← הצמדת אפליקציה (השם משתנה לפי היצרן).</string>
    <string name="settings_open_security">פתיחת הגדרות האבטחה</string>
    <string name="settings_managed_available">מכשיר מנוהל: נעילה מלאה (Lock Task) זמינה ותופעל במקום הצמדה רגילה.</string>
    <string name="settings_managed_unavailable">נעילה מנוהלת לא זמינה במכשיר זה. היא אפשרית רק במכשיר ייעודי שהוגדר ידנית כמכשיר מנוהל (ראה מדריך ההתקנה). במכשיר אישי רגיל משתמשים בהצמדת מסך.</string>
    <string name="settings_remove_owner">הסרת FocusLock מניהול המכשיר</string>
    <string name="settings_remove_owner_confirm">פעולה זו מבטלת את מצב הנעילה המנוהלת. להמשיך?</string>
    <string name="settings_section_screen">מסך בזמן עבודה</string>
    <string name="settings_keep_screen_on">להשאיר את המסך דולק</string>
    <string name="settings_keep_screen_on_desc">כבוי: המסך ייכבה כרגיל והטיימר ימשיך לרוץ ברקע.</string>
    <string name="settings_dim">תצוגה חסכונית (בהירות נמוכה)</string>
    <string name="settings_section_schedule">תזמון</string>
    <string name="settings_auto_start">להתחיל סשן מתוזמן אוטומטית</string>
    <string name="settings_auto_start_desc">הטיימר וההשתקה יתחילו בזמן. Android לא מאפשר לפתוח מסך מלא מהרקע, לכן תופיע התראה לפתיחת הטיימר. כבוי: תופיע התראה עם כפתור \"התחל סשן\".</string>
    <string name="settings_section_look">מראה</string>
    <string name="theme_system">לפי המכשיר</string>
    <string name="theme_light">בהיר</string>
    <string name="theme_dark">כהה</string>
    <string name="settings_section_permissions">הרשאות</string>
    <string name="perm_granted">ניתנה</string>
    <string name="perm_missing">לא ניתנה</string>
    <string name="perm_grant">אישור</string>
    <string name="perm_notifications">התראות</string>
    <string name="perm_notifications_desc">להצגת הטיימר בשורת ההתראות ולתזכורות על סשנים מתוזמנים.</string>
    <string name="perm_dnd">גישה ל\"נא לא להפריע\"</string>
    <string name="perm_dnd_desc">מאפשרת להשתיק התראות ושיחות בזמן עבודה ולהחזיר את המצב בסיום. בחר FocusLock ברשימה והפעל.</string>
    <string name="perm_exact">התראות ותזכורות (שעון מדויק)</string>
    <string name="perm_exact_desc">כדי שסשן מתוזמן יתחיל בדיוק בזמן, ושהסשן יסתיים בדיוק באפס גם כשהמסך כבוי.</string>
    <string name="perm_battery">פטור מחיסכון בסוללה (מומלץ)</string>
    <string name="perm_battery_desc">בחלק מהמכשירים (כמו Xiaomi, Samsung) חיסכון אגרסיבי בסוללה עלול לעצור את הטיימר. בחר FocusLock ← \"ללא הגבלה\".</string>

